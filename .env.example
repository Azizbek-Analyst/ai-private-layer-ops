# API key for x-api-key header (use a strong secret in production)
API_KEY=dev-secret-demo

# Comma-separated list of allowed tenant IDs (empty = allow all from tenants.yaml)
TENANT=

# 64 hex chars (32 bytes) for token encryption; generate: openssl rand -hex 32
TOKEN_KEY_HEX=1111111111111111111111111111111111111111111111111111111111111111

# GLiNER model name (default used if not set)
# Examples: urchade/gliner_multi-v2.1, urchade/gliner_medium-v2.1, gliner-community/gliner_medium-v2.5
# GLINER_MODEL=urchade/gliner_multi-v2.1

# Path to tenants.yaml (optional; default: repo root or cwd)
# TENANT_CONFIG=/path/to/tenants.yaml

# Server (optional)
# HOST=0.0.0.0
# PORT=9000
